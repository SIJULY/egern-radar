#!name=中国电信
#!desc=电信话费 / 流量 / 语音定时推送；Safari 登录一次后自动抓取 Cookie 并续期
#!author=小秘书
#!icon=phone.fill

# 安装：在 Surge → 模块 → 安装模块 → 粘贴本文件 raw 链接
# https://raw.githubusercontent.com/SIJULY/egern-radar/main/china-telecom.sgmodule
#
# 首次使用：在 Safari 打开 https://e.dlife.cn 短信登录一次，
# Cookie 会被自动捕获，之后每天 6:35 / 18:35 自动推送数据。
# Cookie 失效时会自动回放续期；续不上会通知你重新登录。
#
# cron 参数（在 [Script] 的 argument 中修改）：
#   silent=true       成功时不推送摘要（默认推送）
#   showUsed=true     显示已用流量（默认显示剩余流量）
#   filterDirec=true  过滤定向流量

[Script]
中国电信Cookie捕获 = type=http-request,pattern=^https://e\.dlife\.cn/,requires-body=0,script-path=https://raw.githubusercontent.com/SIJULY/egern-radar/main/china-telecom-surge.js
中国电信定时刷新 = type=cron,cronexp=35 6,18 * * *,wake-system=0,timeout=30,script-path=https://raw.githubusercontent.com/SIJULY/egern-radar/main/china-telecom-surge.js,argument=

[MITM]
hostname = %APPEND% e.dlife.cn
