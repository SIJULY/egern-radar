ngge': '长葛',\n  'Zhanggong': '章贡',\n  'Zhanghai': '长海',\n  'Zhanghua': '彰化',\n  'Zhangjiachuan': '张家川',\n  'Zhangjiagang': '张家港',\n  'Zhangjiajie': '张家界',\n  'Zhangjiakou': '张家口',\n  'Zhangling': '长岭',\n  'Zhangning': '长宁',\n  'Zhangping': '漳平',\n  'Zhangpu': '漳浦',\n  'Zhangqing': '长清',\n  'Zhangqiu': '章丘',\n  'Zhangshu': '樟树',\n  'Zhangshun': '长顺',\n  'Zhangtai': '长泰',\n  'Zhangwan': '张湾',\n  'Zhangwu': '彰武',\n  'Zhangxian': '漳县',\n  'Zhangyang': '长阳',\n  'Zhangye': '张掖',\n  'Zhangyuan': '长垣',\n  'Zhangzhi': '长治',\n  'Zhangzhou': '漳州',\n  'Zhangzi': '长子',\n  'Zhanhe': '湛河',\n  'Zhanhua': '沾化',\n  'Zhanjiang': '湛江',\n  'Zhanqian': '站前',\n  'Zhanyi': '沾益',\n  'Zhaoan': '诏安',\n  'Zhaodong': '肇东',\n  'Zhaohua': '昭化',\n  'Zhaojue': '昭觉',\n  'Zhaoling': '召陵',\n  'Zhaoping': '昭平',\n  'Zhaoqing': '肇庆',\n  'Zhaosu': '昭苏',\n  'Zhaotong': '昭通',\n  'Zhaoxian': '赵县',\n  'Zhaoyang': '朝阳',\n  'Zhaoyuan': '肇源',\n  'Zhaozhou': '肇州',\n  'Zhashui': '柞水',\n  'Zhecheng': '柘城',\n  'Zhenan': '振安',\n  'Zhenba': '镇巴',\n  'Zhenfeng': '贞丰',\n  'Zhengan': '正安',\n  'Zhengding': '正定',\n  'Zhenghe': '政和',\n  'Zhenglanqi': '正蓝旗',\n  'Zhengning': '正宁',\n  'Zhengxiang': '蒸湘',\n  'Zhengxiangbaiqi': '正镶白旗',\n  'Zhengyang': '正阳',\n  'Zhengzhou': '郑州',\n  'Zhenhai': '镇海',\n  'Zhenjiang': '镇江',\n  'Zhenkang': '镇康',\n  'Zhenlai': '镇赉',\n  'Zhenning': '镇宁',\n  'Zhenping': '镇坪',\n  'Zhenxing': '振兴',\n  'Zhenxiong': '镇雄',\n  'Zhenyuan': '镇原',\n  'Zherong': '柘荣',\n  'Zhidan': '志丹',\n  'Zhiduo': '治多',\n  'Zhifu': '芝罘',\n  'Zhijiang': '枝江',\n  'Zhijin': '织金',\n  'Zhongba': '仲巴',\n  'Zhongfang': '中方',\n  'Zhongjiang': '中江',\n  'Zhonglou': '钟楼',\n  'Zhongmu': '中牟',\n  'Zhongning': '中宁',\n  'Zhongsha': '中沙',\n  'Zhongshan': '中山',\n  'Zhongwei': '中卫',\n  'Zhongxian': '忠县',\n  'Zhongxiang': '钟祥',\n  'Zhongyang': '中阳',\n  'Zhongyuan': '中原',\n  'Zhongzhan': '中站',\n  'Zhoucun': '周村',\n  'Zhoukou': '周口',\n  'Zhouning': '周宁',\n  'Zhouqu': '舟曲',\n  'Zhoushan': '舟山',\n  'Zhouzhi': '周至',\n  'Zhuanghe': '庄河',\n  'Zhuanglang': '庄浪',\n  'Zhucheng': '诸城',\n  'Zhuhai': '珠海',\n  'Zhuhui': '珠晖',\n  'Zhuji': '诸暨',\n  'Zhumadian': '驻马店',\n  'Zhungeer': '准格尔',\n  'Zhuolu': '涿鹿',\n  'Zhuoni': '卓尼',\n  'Zhuozhou': '涿州',\n  'Zhuozi': '卓资',\n  'Zhurihe': '朱日和',\n  'Zhushan': '竹山',\n  'Zhuxi': '竹溪',\n  'Zhuzhou': '株洲',\n  'Zibo': '淄博',\n  'Zichuan': '淄川',\n  'Zigong': '自贡',\n  'Zigui': '秭归',\n  'Zijin': '紫金',\n  'Ziliujing': '自流井',\n  'Zitong': '梓潼',\n  'Zixi': '资溪',\n  'Zixing': '资兴',\n  'Ziyang': '资阳',\n  'Ziyuan': '资源',\n  'Ziyun': '紫云',\n  'Zizhang': '子长',\n  'Zizhong': '资中',\n  'Zizhou': '子洲',\n  'Zongyang': '枞阳',\n  'Zoucheng': '邹城',\n  'Zouping': '邹平',\n  'Zunhua': '遵化',\n  'Zunyi': '遵义',\n  'Zuogong': '左贡',\n  'Zuoquan': '左权',\n  'Zuoyun': '左云'\n};\n\nconst WC_HEADERS = {\n  Referer: 'https://www.weather.com.cn/',\n  'User-Agent':\n    'Mozilla/5.0 (iPhone; CPU iPhone OS 18_7 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/27.2 Mobile/15E148 Safari/604.1',\n}\n\nasync function httpGetText(url, headers = {}, timeoutSec = 8) {\n  let lastErr = null\n  for (let i = 0; i < 2; i++) {\n    try {\n      const req = new Request(url)\n      req.timeoutInterval = timeoutSec\n      req.headers = headers\n      return await req.loadString()\n    } catch (e) {\n      lastErr = e\n    }\n  }\n  throw lastErr\n}\n\nasync function httpGetJSON(url, headers = {}, timeoutSec = 6) {\n  const req = new Request(url)\n  req.timeoutInterval = timeoutSec\n  req.headers = Object.assign({ Accept: 'application/json' }, headers)\n  return await req.loadJSON()\n}\n\nasync function getCityByIP() {\n  const apis = [\n    { url: 'https://ipapi.co/json/', key: 'city' },\n    { url: 'https://freeipapi.com/api/json', key: 'cityName' },\n  ]\n  for (const api of apis) {\n    try {\n      const json = await httpGetJSON(api.url, {}, 5)\n      let raw = String((json && json[api.key]) || '').trim()\n      if (raw) {\n        const cn = EN2CN_CITY[raw] || raw.replace(/市$/, '')\n        storageSet(NS + 'last-ip-city', { city: cn, at: new Date().toISOString() })\n        return cn\n      }\n    } catch (_) {}\n  }\n  const last = storageGet(NS + 'last-ip-city')\n  if (last && last.city && age(last.at) < 86400000 * 3) return last.city\n  return '合肥'\n}\n\nasync function getCityCode(cityName) {\n  const cleanName = String(cityName || '').trim().replace(/(市|区|县)$/, '')\n  if (/^\\d{9}$/.test(cleanName)) return cleanName\n  if (CITY_PRESETS[cleanName]) return CITY_PRESETS[cleanName]\n  if (CITY_PRESETS[cityName]) return CITY_PRESETS[cityName]\n\n  const ck = NS + 'citycode:' + cleanName\n  const cached = storageGet(ck)\n  if (cached && cached.code && age(cached.at) < 86400000 * 30) return cached.code\n\n  try {\n    const url = `https://toy1.weather.com.cn/search?cityname=${encodeURIComponent(cleanName)}`\n    const text = await httpGetText(url, WC_HEADERS, 6)\n    const start = text.indexOf('[')\n    const end = text.lastIndexOf(']')\n    if (start >= 0 && end > start) {\n      const arr = JSON.parse(text.slice(start, end + 1))\n      if (Array.isArray(arr) && arr.length > 0) {\n        for (const item of arr) {\n          const ref = String(item.ref || '')\n          const parts = ref.split('~')\n          const code = parts[0]\n          const name = parts[2]\n          if (/^\\d{9}$/.test(code) && (name === cleanName || name === cityName)) {\n            storageSet(ck, { code, at: new Date().toISOString() })\n            return code\n          }\n        }\n        const firstCode = String(arr[0].ref || '').split('~')[0]\n        if (/^\\d{9}$/.test(firstCode)) {\n          storageSet(ck, { code: firstCode, at: new Date().toISOString() })\n          return firstCode\n        }\n      }\n    }\n  } catch (_) {}\n\n  return CITY_PRESETS['合肥']\n}\n\nfunction pickVarJSON(text, name) {\n  const idx = text.indexOf(`var ${name}`)\n  if (idx < 0) return null\n  const start = text.indexOf('{', idx)\n  if (start < 0) return null\n  let depth = 0\n  let inStr = false\n  let esc = false\n  for (let i = start; i < text.length; i++) {\n    const ch = text[i]\n    if (inStr) {\n      if (esc) {\n        esc = false\n        continue\n      }\n      if (ch === '\\\\') {\n        esc = true\n        continue\n      }\n      if (ch === '\"') inStr = false\n      continue\n    }\n    if (ch === '\"') {\n      inStr = true\n      continue\n    }\n    if (ch === '{') depth++\n    if (ch === '}') {\n      depth--\n      if (depth === 0) {\n        const jsonText = text.slice(start, i + 1)\n        try {\n          return JSON.parse(jsonText)\n        } catch (_) {\n          return null\n        }\n      }\n    }\n  }\n  return null\n}\n\nasync function fetchWeather(code) {\n  const url = `https://d1.weather.com.cn/weather_index/${code}.html?_=${Date.now()}`\n  const text = await httpGetText(url, WC_HEADERS, 8)\n  const cityDZ = pickVarJSON(text, 'cityDZ')\n  const dataSK = pickVarJSON(text, 'dataSK')\n  const dataZS = pickVarJSON(text, 'dataZS')\n  const fc = pickVarJSON(text, 'fc')\n  const alarmDZ = pickVarJSON(text, 'alarmDZ')\n  return { cityDZ, dataSK, dataZS, fc, alarmDZ }\n}\n\nasync function fetch7Day(code) {\n  try {\n    const url = `https://www.weather.com.cn/weather/${code}.shtml`\n    const html = await httpGetText(url, WC_HEADERS, 8)\n    const hour3 = pickVarJSON(html, 'hour3data')\n\n    const ulMatch = html.match(/id=\"7d\"[\\s\\S]*?<ul[^>]*class=\"t clearfix\"[^>]*>([\\s\\S]*?)<\\/ul>/i)\n    const block = ulMatch ? ulMatch[1] : html\n    const liList = block.match(/<li[\\s\\S]*?<\\/li>/gi) || []\n    const out = []\n\n    for (const li of liList) {\n      const h1 = (li.match(/<h1>(.*?)<\\/h1>/i)?.[1] || '').trim()\n      const wea = (li.match(/class=\"wea\"[^>]*>(.*?)<\\/p>/i)?.[1] || '').trim()\n      if (!h1 || !wea) continue\n\n      const high = (li.match(/class=\"tem\"[\\s\\S]*?<span>(-?\\d+)<\\/span>/i)?.[1] || '').trim()\n      const low = (li.match(/class=\"tem\"[\\s\\S]*?<i>(-?\\d+)℃?<\\/i>/i)?.[1] || '').trim()\n\n      const codes = [...li.matchAll(/class=\"big[dn](\\d{2})\"/gi)].map(m => m[1])\n      const codeDay = codes[0] || ''\n      const codeNight = codes[1] || codeDay || ''\n\n      const win = (li.match(/class=\"win\"[\\s\\S]*?<i>(.*?)<\\/i>/i)?.[1] || '').trim()\n\n      const dm = h1.match(/(\\d+日)（(.*?)）/)\n      const date = dm ? dm[1] : h1\n      const week = dm ? dm[2] : ''\n\n      out.push({\n        date,\n        week,\n        tempMax: high || '--',\n        tempMin: low || '--',\n        codeDay,\n        codeNight,\n        textDay: wea,\n        windDay: win,\n      })\n\n      if (out.length >= 7) break\n    }\n    return { seven: out, hour3 }\n  } catch (_) {\n    return { seven: [], hour3: null }\n  }\n}\n\nfunction calcFeelsLike(tempVal, rhVal, windKmhVal) {\n  const t = Number(tempVal)\n  if (!Number.isFinite(t)) return ''\n  const rh = Number(String(rhVal || '').replace('%', ''))\n  const vKmh = Number(String(windKmhVal || '').replace(/km\\/h/i, ''))\n  const vMs = Number.isFinite(vKmh) ? vKmh / 3.6 : 1.5\n  const h = Number.isFinite(rh) ? rh : 50\n  const e = (h / 100) * 6.105 * Math.exp((17.27 * t) / (237.7 + t))\n  const at = t + 0.33 * e - 0.7 * vMs - 4.0\n  return String(Math.round(at))\n}\n\nfunction aqiCategory(val) {\n  const n = Number(val)\n  if (!Number.isFinite(n) || n <= 0) return ''\n  if (n <= 50) return '优'\n  if (n <= 100) return '良'\n  if (n <= 150) return '轻度'\n  if (n <= 200) return '中度'\n  if (n <= 300) return '重度'\n  return '严重'\n}\n\nfunction validTempStr(v) {\n  const s = String(v == null ? '' : v).trim()\n  if (!s || s === '--' || s === '999' || s === '-999') return ''\n  const n = Number(s)\n  return Number.isFinite(n) && Math.abs(n) < 90 ? String(Math.round(n)) : ''\n}\n\nfunction parseHour3List(hour3, baseIsoDate) {\n  const list = (hour3 && hour3['1d'] && hour3['1d'].length ? hour3['1d'] : [])\n  if (!list.length) return []\n  const [y, m] = baseIsoDate.split('-').map(Number)\n  return list.slice(0, 8).map(item => {\n    const parts = String(item || '').split(',')\n    const timeRaw = parts[0] || ''\n    const codeRaw = parts[1] || ''\n    const textRaw = parts[2] || ''\n    const tempRaw = String(parts[3] || '').replace(/℃/g, '').trim()\n    const dm = timeRaw.match(/(\\d{1,2})日(\\d{1,2})时/)\n    let fxTime = ''\n    if (dm) {\n      const dt = new Date(y, m - 1, Number(dm[1]), Number(dm[2]), 0, 0)\n      fxTime = dt.toISOString()\n    }\n    return {\n      fxTime: fxTime || `${baseIsoDate}T00:00:00`,\n      hourText: dm ? `${String(dm[2]).padStart(2, '0')}:00` : timeRaw,\n      icon: codeRaw || textRaw,\n      text: textRaw,\n      temp: tempRaw,\n    }\n  })\n}\n\nasync function getWeather(force = false, param) {\n  const widgetParam = typeof args !== 'undefined' && args.widgetParameter ? String(args.widgetParameter) : ''\n  const raw = String(param != null ? param : (widgetParam || settings().location)).trim()\n  const isAuto = !raw || /^(自动|gps|auto)$/i.test(raw)\n  const cacheKey = binding(isAuto ? '自动' : raw)\n  const cached = storageGet(cacheKey)\n  if (!force && cached && age(cached.fetchedAt) >= 0 && age(cached.fetchedAt) < 1200000) {\n    return Object.assign({}, cached, { stale: false })\n  }\n  try {\n    const targetCity = isAuto ? await getCityByIP() : raw\n    const code = await getCityCode(targetCity)\n    const [rawWeather, sevenRes] = await Promise.all([fetchWeather(code), fetch7Day(code)])\n\n    const dz = (rawWeather && rawWeather.cityDZ && rawWeather.cityDZ.weatherinfo) || {}\n    const sk = (rawWeather && rawWeather.dataSK) || {}\n    const zs = (rawWeather && rawWeather.dataZS && rawWeather.dataZS.zs) || {}\n    const fcList = (rawWeather && rawWeather.fc && rawWeather.fc.f) || []\n    const alarms = (rawWeather && rawWeather.alarmDZ && rawWeather.alarmDZ.w) || []\n    const seven = (sevenRes && sevenRes.seven) || []\n\n    if (!sk.temp && !dz.temp && !fcList.length) throw new Error('中国天气网实况数据暂不可用')\n\n    const nowDate = new Date()\n    const baseIso = `${nowDate.getFullYear()}-${String(nowDate.getMonth() + 1).padStart(2, '0')}-${String(nowDate.getDate()).padStart(2, '0')}`\n    const skTime = /^\\d{1,2}:\\d{2}$/.test(String(sk.time || '').trim())\n      ? String(sk.time).trim().padStart(5, '0')\n      : `${String(nowDate.getHours()).padStart(2, '0')}:${String(nowDate.getMinutes()).padStart(2, '0')}`\n    const obsTime = `${baseIso}T${skTime}:00+08:00`\n\n    const sourceDays = seven.length > 0\n      ? seven\n      : fcList.map((f, idx) => ({\n          date: f.fi || '',\n          week: idx === 0 ? '今天' : (f.fj || ''),\n          tempMax: f.fc,\n          tempMin: f.fd,\n          codeDay: f.fa,\n          codeNight: f.fb,\n          textDay: codeToText(f.fa) || codeToText(f.fb) || dz.weather || sk.weather || '',\n          windDay: f.fg || '',\n        }))\n\n    const baseMs = Date.parse(`${baseIso}T00:00:00Z`)\n    const days = sourceDays.map((d, idx) => {\n      const fxDate = new Date(baseMs + idx * 86400000).toISOString().slice(0, 10)\n      const fcFallback = fcList[idx] || {}\n      let tMax = validTempStr(d.tempMax) || validTempStr(fcFallback.fc)\n      let tMin = validTempStr(d.tempMin) || validTempStr(fcFallback.fd)\n      if (idx === 0) {\n        tMax = tMax || validTempStr(dz.temp) || validTempStr(sk.temp)\n        tMin = tMin || validTempStr(dz.tempn) || validTempStr(sk.temp)\n      }\n      if (tMax && tMin && Number(tMax) < Number(tMin)) { const tmp = tMax; tMax = tMin; tMin = tmp }\n      const textDay = d.textDay || codeToText(d.codeDay) || (idx === 0 ? (dz.weather || sk.weather) : '') || '—'\n      return {\n        fxDate,\n        tempMax: tMax || '--',\n        tempMin: tMin || '--',\n        iconDay: d.codeDay || textDay,\n        iconNight: d.codeNight || d.codeDay || textDay,\n        textDay,\n        windDay: d.windDay || '',\n        precip: idx === 0 ? String(sk.rain24h || sk.rain || '0') : '',\n        sunrise: '06:00',\n        sunset: '18:30',\n      }\n    })\n\n    const todayObj = days[0] || {\n      fxDate: baseIso,\n      tempMax: validTempStr(dz.temp) || validTempStr(fcList[0] && fcList[0].fc) || validTempStr(sk.temp) || '--',\n      tempMin: validTempStr(dz.tempn) || validTempStr(fcList[0] && fcList[0].fd) || validTempStr(sk.temp) || '--',\n      iconDay: sk.weathercode || dz.weathercode || sk.weather || '00',\n      textDay: dz.weather || sk.weather || '—',\n      precip: String(sk.rain24h || sk.rain || '0'),\n      sunrise: '06:00',\n      sunset: '18:30',\n    }\n\n    const curTemp = validTempStr(sk.temp) || todayObj.tempMax || '--'\n    const humidityNum = String(sk.SD || sk.sd || '').replace(/%/g, '').trim()\n    const windScaleClean = String(sk.WS || dz.ws || '').replace(/级.*$/, '').trim()\n    const windSpeedClean = String(sk.wse || '').replace(/km\\/h/i, '').trim()\n    const visClean = String(sk.njd || '').replace(/km/i, '').trim()\n\n    const now = {\n      temp: String(sk.temp || curTemp).replace(/℃/g, '').trim(),\n      feelsLike: calcFeelsLike(sk.temp || curTemp, humidityNum, windSpeedClean) || curTemp,\n      text: String(sk.weather || dz.weather || todayObj.textDay || '—').trim(),\n      icon: String(sk.weather || sk.weathercode || dz.weathercode || '00').trim(),\n      humidity: humidityNum,\n      windDir: String(sk.WD || dz.wd || '').trim(),\n      windScale: windScaleClean,\n      windSpeed: windSpeedClean,\n      precip: String(sk.rain || sk.rain24h || '0').trim(),\n      vis: visClean,\n      pressure: String(sk.qy || '').trim(),\n    }\n\n    const aqiVal = String(sk.aqi || '').trim()\n    const aqi = aqiVal && Number.isFinite(Number(aqiVal)) ? { value: aqiVal, label: aqiCategory(aqiVal) } : undefined\n    const warnings = alarms && alarms.length\n      ? alarms.map(w => ({ title: String(w.w13 || `${w.w5 || ''}${w.w7 || ''}预警` || '').trim() })).filter(w => w.title && w.title !== '预警')\n      : []\n\n    const data = {\n      place: String(sk.cityname || dz.city || targetCity || '合肥').replace(/市$/, ''),\n      isAuto,\n      fetchedAt: new Date().toISOString(),\n      obsTime,\n      now,\n      daily: days,\n      today: todayObj,\n      hourly: parseHour3List(sevenRes && sevenRes.hour3, baseIso),\n      aqi,\n      warnings,\n      life: {\n        cloth: zs.ct_hint || zs.ct_des_s || '--',\n        uv: zs.uv_hint || zs.ziwanxian_hint || '--',\n        car: zs.xc_hint || '--',\n        cold: zs.gm_hint || '--',\n        umbrella: zs.ys_hint || '--',\n      },\n      partial: [],\n    }\n    storageSet(cacheKey, data)\n    return data\n  } catch (e) {\n    if (cached && age(cached.fetchedAt) >= 0 && age(cached.fetchedAt) < 21600000) {\n      return Object.assign({}, cached, { stale: true })\n    }\n    throw e\n  }\n}\n\nfunction dayLabel(date) {\n  return ['周日', '周一', '周二', '周三', '周四', '周五', '周六'][new Date(`${date.slice(0, 10)}T12:00:00Z`).getUTCDay()] || '—'\n}\n\nfunction fmtTime(iso) {\n  const d = new Date(iso)\n  if (!Number.isFinite(d.getTime())) return '--:--'\n  return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`\n}\n\n// ─── 主题颜色与基础工具 (Scriptable Color.dynamic + 透明背景高对比配色) ───\nconst dynColor = (lightHex, darkHex) => Color.dynamic(new Color(lightHex), new Color(darkHex))\n\nfunction resolveThemeColor(lightCardHex, darkCardHex, transLightTextHex, transDarkTextHex) {\n  if (!hasTransparentBg()) {\n    return dynColor(lightCardHex, darkCardHex)\n  }\n  const mode = (settings().bgTextMode || 'light').toLowerCase()\n  const hiLight = transLightTextHex || darkCardHex\n  const hiDark = transDarkTextHex || lightCardHex\n  if (mode === 'dark') return new Color(hiDark)\n  if (mode === 'auto') return dynColor(hiDark, hiLight)\n  return new Color(hiLight)\n}\n\nconst COLORS = {\n  ink: () => resolveThemeColor('#16324A', '#F2F7FC', '#FFFFFF', '#0D2235'),\n  secondary: () => resolveThemeColor('#607287', '#A9B9CD', '#E6F0FA', '#2C4257'),\n  quiet: () => resolveThemeColor('#7B8A9D', '#7F93AD', '#D4E4F7', '#41586E'),\n  blue: () => resolveThemeColor('#257CC5', '#78B8FF', '#82CCFF', '#0E5A9E'),\n  warm: () => resolveThemeColor('#D8752A', '#FFAA67', '#FFC478', '#B8540A'),\n  teal: () => resolveThemeColor('#188E98', '#61D1D5', '#72F2F7', '#0A6E78'),\n  green: () => resolveThemeColor('#23946B', '#65D5A8', '#78F7BE', '#0F754E'),\n  violet: () => resolveThemeColor('#6574C7', '#A8B3FF', '#C4CEFF', '#4352A8'),\n  cyan: () => resolveThemeColor('#1687B8', '#65C9EE', '#7CE2FF', '#0B6996'),\n  highColor: () => resolveThemeColor('#D85D3F', '#FF8B72', '#FFA28C', '#B83B1D'),\n  lowColor: () => resolveThemeColor('#4879AF', '#83B8ED', '#96CEFF', '#27588F'),\n  track: () => resolveThemeColor('#DCE6F1', '#2A3B53', '#FFFFFF45', '#00000028'),\n  tealTrack: () => resolveThemeColor('#D7E9EA', '#29484D', '#FFFFFF45', '#00000028'),\n  panel: () => resolveThemeColor('#EAF0F7', '#1D2B41', '#00000033', '#FFFFFF38'),\n  amber: () => resolveThemeColor('#A96A17', '#F1C077', '#FFD485', '#8C5205'),\n}\n\n// ─── 透明背景与壁纸裁切工具 ───\nconst BG_DEVICE_MAP = {\n  2868: { small: 510, medium: 1092, large: 1146, left: 78, right: 654, top: 270, middle: 912, bottom: 1554 },\n  2796: { small: 510, medium: 1092, large: 1146, left: 99, right: 681, top: 282, middle: 918, bottom: 1554 },\n  2778: { small: 510, medium: 1092, large: 1146, left: 96, right: 678, top: 246, middle: 882, bottom: 1518 },\n  2688: { small: 507, medium: 1080, large: 1137, left: 81, right: 654, top: 228, middle: 858, bottom: 1488 },\n  2622: { small: 486, medium: 1032, large: 1098, left: 87, right: 633, top: 261, middle: 873, bottom: 1485 },\n  2556: { small: 474, medium: 1014, large: 1062, left: 82, right: 622, top: 270, middle: 858, bottom: 1446 },\n  2532: { small: 474, medium: 1014, large: 1062, left: 78, right: 618, top: 231, middle: 819, bottom: 1407 },\n  2436: { small: 465, medium: 987, large: 1035, left: 69, right: 591, top: 213, middle: 783, bottom: 1353 },\n  1792: { small: 338, medium: 720, large: 758, left: 54, right: 436, top: 160, middle: 580, bottom: 1000 },\n  2208: { small: 471, medium: 1044, large: 1071, left: 99, right: 672, top: 114, middle: 696, bottom: 1278 },\n  1334: { small: 296, medium: 642, large: 648, left: 54, right: 400, top: 60, middle: 412, bottom: 764 },\n  1136: { small: 282, medium: 584, large: 622, left: 30, right: 332, top: 59, middle: 399, bottom: 739 },\n}\n\nfunction normalizeFamily(family) {\n  if (family === 'small' || family === 'systemSmall') return 'small'\n  if (family === 'large' || family === 'systemLarge') return 'large'\n  return 'medium'\n}\n\nfunction getBgFilePath(family) {\n  const fm = FileManager.local()\n  const norm = normalizeFamily(family)\n  return fm.joinPath(fm.documentsDirectory(), `qweather_bg_${norm}.jpg`)\n}\n\nfunction getCustomBgFilePath() {\n  const fm = FileManager.local()\n  return fm.joinPath(fm.documentsDirectory(), 'qweather_bg_custom.jpg')\n}\n\nfunction hasTransparentBg(family) {\n  const fm = FileManager.local()\n  if (family && fm.fileExists(getBgFilePath(family))) return true\n  return (\n    fm.fileExists(getBgFilePath('medium')) ||\n    fm.fileExists(getBgFilePath('small')) ||\n    fm.fileExists(getBgFilePath('large')) ||\n    fm.fileExists(getCustomBgFilePath())\n  )\n}\n\nfunction applyOverlayToImage(img, w, h, overlayMode) {\n  const dc = new DrawContext()\n  dc.size = new Size(w, h)\n  dc.opaque = false\n  dc.drawImageInRect(img, new Rect(0, 0, w, h))\n  if (overlayMode === 'light') {\n    dc.setFillColor(new Color('#FFFFFF', 0.22))\n    dc.fillRect(new Rect(0, 0, w, h))\n  } else if (overlayMode === 'dark') {\n    dc.setFillColor(new Color('#0D1624', 0.28))\n    dc.fillRect(new Rect(0, 0, w, h))\n  }\n  return dc.getImage()\n}\n\nfunction cropWallpaperForWidget(img, family, posKey, overlayMode = 'none') {\n  const imgW = img.size.width\n  const imgH = img.size.height\n  const spec = BG_DEVICE_MAP[imgH] || {\n    small: Math.round(imgW * 0.395),\n    medium: Math.round(imgW * 0.846),\n    large: Math.round(imgH * 0.41),\n    left: Math.round(imgW * 0.077),\n    right: Math.round(imgW * 0.528),\n    top: Math.round(imgH * 0.1),\n    middle: Math.round(imgH * 0.328),\n    bottom: Math.round(imgH * 0.556),\n  }\n\n  let x = spec.left\n  let y = spec.top\n  let w = spec.medium\n  let h = spec.small\n\n  const norm = normalizeFamily(family)\n  if (norm === 'small') {\n    w = spec.small\n    h = spec.small\n    x = posKey.includes('right') ? spec.right : spec.left\n    if (posKey.includes('middle')) y = spec.middle\n    else if (posKey.includes('bottom')) y = spec.bottom\n    else y = spec.top\n  } else if (norm === 'medium') {\n    w = spec.medium\n    h = spec.small\n    x = spec.left\n    if (posKey === 'middle') y = spec.middle\n    else if (posKey === 'bottom') y = spec.bottom\n    else y = spec.top\n  } else {\n    w = spec.medium\n    h = spec.large\n    x = spec.left\n    y = posKey === 'bottom' ? spec.middle : spec.top\n  }\n\n  const dc = new DrawContext()\n  dc.size = new Size(w, h)\n  dc.opaque = false\n  dc.drawImageAtPoint(img, new Point(-x, -y))\n  if (overlayMode === 'light') {\n    dc.setFillColor(new Color('#FFFFFF', 0.22))\n    dc.fillRect(new Rect(0, 0, w, h))\n  } else if (overlayMode === 'dark') {\n    dc.setFillColor(new Color('#0D1624', 0.28))\n    dc.fillRect(new Rect(0, 0, w, h))\n  }\n  return dc.getImage()\n}\n\nfunction applyWidgetBackground(widget, family = 'medium') {\n  const fm = FileManager.local()\n  const norm = normalizeFamily(family)\n  const candidates = [getBgFilePath(norm), getCustomBgFilePath(), getBgFilePath('medium')]\n  for (const p of candidates) {\n    if (fm.fileExists(p)) {\n      try {\n        widget.backgroundImage = fm.readImage(p)\n        return\n      } catch (_) {}\n    }\n  }\n  const grad = new LinearGradient()\n  grad.colors = [dynColor('#FCFDFF', '#1B2A42'), dynColor('#EDF3FA', '#101A2C')]\n  grad.locations = [0, 1]\n  grad.startPoint = new Point(0.5, 0)\n  grad.endPoint = new Point(0.5, 1)\n  widget.backgroundGradient = grad\n}\n\nfunction clean(value) {\n  const s = String(value == null ? '' : value).trim()\n  return !s || /^(?:--?|null|undefined|nan|n\\/a)$/i.test(s) ? '' : s\n}\n\nfunction numeric(value) {\n  const s = clean(value)\n  if (!s) return undefined\n  const n = Number(s)\n  return Number.isFinite(n) ? n : undefined\n}\n\nfunction temp(value) {\n  const n = numeric(value)\n  return n == null ? '—' : `${Math.round(n)}°`\n}\n\nfunction unit(value, suffix) {\n  return clean(value) ? `${clean(value)}${suffix}` : '—'\n}\n\nfunction updated(data) {\n  const date = clean(data.fetchedAt)\n  if (!date || !Number.isFinite(Date.parse(date))) return '--:--'\n  const m = clean(data.obsTime).match(/T(\\d{2}:\\d{2})/)\n  const time = m ? m[1] : fmtTime(date)\n  return `${data.stale ? '缓存 ' : ''}${time}`\n}\n\nfunction dateOnly(value) {\n  const s = clean(value).slice(0, 10)\n  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(s)) return ''\n  const d = new Date(`${s}T00:00:00Z`)\n  return Number.isFinite(d.getTime()) && d.toISOString().slice(0, 10) === s ? s : ''\n}\n\nfunction baseDate(data) {\n  return dateOnly(data.today && data.today.fxDate) || dateOnly(data.obsTime) || dateOnly(data.fetchedAt)\n}\n\nfunction getToday(data) {\n  const b = baseDate(data)\n  return data.today || (data.daily || []).find(d => d.fxDate === b)\n}\n\nfunction getForecast(data) {\n  const base = baseDate(data)\n  if (!base) return []\n  const start = Date.parse(`${base}T00:00:00Z`)\n  return Array.from({ length: 5 }, (_, i) => {\n    const date = new Date(start + (i + 1) * 86400000).toISOString().slice(0, 10)\n    return { date, day: (data.daily || []).find(d => d.fxDate === date) }\n  })\n}\n\nfunction isNight(data) {\n  const observation = clean(data.obsTime)\n  const m = observation.match(/T(\\d{2}:\\d{2})/)\n  const day = getToday(data)\n  const rise = clean(day && day.sunrise)\n  const set = clean(day && day.sunset)\n  if (m && rise && set) return m[1] < rise || m[1] >= set\n  const t = observation.match(/T(\\d{2}):/)\n  return t ? Number(t[1]) < 6 || Number(t[1]) >= 18 : false\n}\n\nfunction codeToText(code) {\n  const c = String(code == null ? '' : code).replace(/^[dn]/i, '')\n  const map = {\n    '00': '晴', '01': '多云', '02': '阴', '03': '阵雨', '04': '雷阵雨', '05': '雷阵雨伴有冰雹',\n    '06': '雨夹雪', '07': '小雨', '08': '中雨', '09': '大雨', '10': '暴雨', '11': '大暴雨',\n    '12': '特大暴雨', '13': '阵雪', '14': '小雪', '15': '中雪', '16': '大雪', '17': '暴雪',\n    '18': '雾', '19': '冻雨', '20': '沙尘暴', '21': '小到中雨', '22': '中到大雨', '23': '大到暴雨',\n    '24': '暴雨到大暴雨', '25': '大暴雨到特大暴雨', '26': '小到中雪', '27': '中到大雪', '28': '大到暴雪',\n    '29': '浮尘', '30': '扬沙', '31': '强沙尘暴', '53': '霾', '32': '浓雾', '301': '雨', '302': '雪', '99': '',\n  }\n  return map[c] || ''\n}\n\nfunction weatherEmoji(code, night = false) {\n  const raw = clean(code)\n  if (!raw) return ''\n  const norm = raw.replace(/^[dn]/i, '')\n  if (/^\\d{1,2}$/.test(norm)) {\n    const pad = norm.padStart(2, '0')\n    if (pad === '00') return night ? '🌙' : '☀️'\n    if (pad === '01') return night ? '☁️' : '🌤️'\n    if (pad === '02') return '☁️'\n    if (['04', '05'].includes(pad)) return '⛈️'\n    if (['03', '07', '08', '09', '10', '11', '12', '19', '21', '22', '23', '24', '25'].includes(pad)) return '🌧️'\n    if (['06', '13', '14', '15', '16', '17', '26', '27', '28'].includes(pad)) return '❄️'\n    if (['18', '20', '29', '30', '31', '32', '53'].includes(pad)) return '🌫️'\n  }\n  const text = codeToText(norm) || raw\n  if (/雷/.test(text)) return '⛈️'\n  if (/雨/.test(text)) return '🌧️'\n  if (/雪|冰雹/.test(text)) return '❄️'\n  if (/雾|霾|沙|尘/.test(text)) return '🌫️'\n  if (/多云/.test(text)) return night ? '☁️' : '🌤️'\n  if (/阴/.test(text)) return '☁️'\n  if (/晴/.test(text)) return night ? '🌙' : '☀️'\n  const c = Number(norm)\n  if (!Number.isFinite(c)) return '🌡️'\n  if (c === 100) return night ? '🌙' : '☀️'\n  if (c === 150 || c === 154) return '🌙'\n  if ([101, 102, 103].includes(c)) return night ? '☁️' : '🌤️'\n  if ([151, 152, 153].includes(c)) return '🌥️'\n  if (c === 104 || (c >= 800 && c <= 808)) return '☁️'\n  if (c >= 200 && c <= 213) return '🌬️'\n  if (c >= 300 && c <= 318) return [302, 303, 304, 310, 311, 312].includes(c) ? '⛈️' : '🌧️'\n  if (c >= 400 && c <= 499) return '❄️'\n  if (c >= 500 && c <= 518) return '🌫️'\n  if (c >= 600 && c <= 609) return '🌨️'\n  if (c >= 700 && c <= 718) return '🌫️'\n  return '🌡️'\n}\n\nfunction dateFestival(data) {\n  const iso = baseDate(data)\n  if (!iso) return { date: '日期未知', festival: '' }\n  const [y, m, d] = iso.split('-').map(Number)\n  const local = new Date(y, m - 1, d, 12)\n  const weekday = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'][local.getDay()]\n  const candidates = [getNextFestivalInfo(local), getNextLunarFestivalInfo(local)]\n    .filter(x => !!x && x.daysLeft >= 0 && x.daysLeft <= 14)\n    .sort((a, b) => a.daysLeft - b.daysLeft)\n  const next = candidates[0]\n  return {\n    date: `${m}月${d}日 · ${weekday}`,\n    festival: !next ? '' : next.daysLeft === 0 ? `今日${next.name}` : `距${next.name} ${next.daysLeft}天`,\n  }\n}\n\n// ─── Scriptable UI 组件构建 ───\nfunction addText(parent, str, opts = {}) {\n  const t = parent.addText(String(str))\n  const size = opts.size || 10\n  if (opts.monospaced) {\n    t.font = Font.regularMonospacedSystemFont(size)\n  } else if (opts.weight === 'bold') {\n    t.font = Font.boldSystemFont(size)\n  } else if (opts.weight === 'semibold') {\n    t.font = Font.semiboldSystemFont(size)\n  } else if (opts.weight === 'medium') {\n    t.font = Font.mediumSystemFont(size)\n  } else {\n    t.font = Font.systemFont(size)\n  }\n  if (opts.color) t.textColor = opts.color\n  t.lineLimit = opts.lineLimit != null ? opts.lineLimit : 1\n  if (opts.minScale) t.minimumScaleFactor = opts.minScale\n  if (hasTransparentBg()) {\n    const mode = (settings().bgTextMode || 'light').toLowerCase()\n    if (mode === 'dark') {\n      t.shadowColor = new Color('#FFFFFF', 0.55)\n      t.shadowRadius = 2\n      t.shadowOffset = new Point(0, 0.8)\n    } else {\n      t.shadowColor = new Color('#000000', 0.52)\n      t.shadowRadius = 2.5\n      t.shadowOffset = new Point(0, 1)\n    }\n  }\n  return t\n}\n\nfunction addSymbol(parent, name, size, tintColor) {\n  try {\n    const sym = SFSymbol.named(name) || SFSymbol.named('questionmark.circle')\n    if (!sym) return null\n    sym.applyFont(Font.systemFont(size))\n    const img = parent.addImage(sym.image)\n    img.imageSize = new Size(size + 2, size + 2)\n    if (tintColor) img.tintColor = tintColor\n    return img\n  } catch (e) {\n    return null\n  }\n}\n\nfunction addWeatherIcon(parent, code, size, night = false) {\n  const emoji = weatherEmoji(code, night)\n  if (emoji) {\n    return addText(parent, emoji, { size, lineLimit: 1 })\n  }\n  return addText(parent, '—', { size: Math.round(size * 0.65), color: COLORS.quiet(), lineLimit: 1 })\n}\n\nfunction drawProgressBar(width, height, ratio, trackHex, fillHex) {\n  const scale = 2\n  const w = Math.max(4, Math.round(width * scale))\n  const h = Math.max(2, Math.round(height * scale))\n  const r = h / 2\n  const dc = new DrawContext()\n  dc.size = new Size(w, h)\n  dc.opaque = false\n  dc.respectScreenScale = true\n\n  const trackPath = new Path()\n  trackPath.addRoundedRect(new Rect(0, 0, w, h), r, r)\n  dc.addPath(trackPath)\n  dc.setFillColor(new Color(trackHex))\n  dc.fillPath()\n\n  if (ratio != null && ratio > 0) {\n    const fw = Math.max(h, Math.min(w, Math.round(w * ratio)))\n    const fillPath = new Path()\n    fillPath.addRoundedRect(new Rect(0, 0, fw, h), r, r)\n    dc.addPath(fillPath)\n    dc.setFillColor(new Color(fillHex))\n    dc.fillPath()\n  }\n  return dc.getImage()\n}\n\nfunction addHeader(parent, data) {\n  const row = parent.addStack()\n  row.layoutHorizontally()\n  row.centerAlignContent()\n  addSymbol(row, 'location.fill', 8, COLORS.blue())\n  row.addSpacer(3)\n  addText(row, clean(data.place) || '当前位置', {\n    size: 9,\n    weight: 'semibold',\n    color: COLORS.blue(),\n    minScale: 0.72,\n  })\n  row.addSpacer()\n  if (data.partial && data.partial.length) {\n    addText(row, '部分数据缺失', { size: 7.5, color: COLORS.amber() })\n    row.addSpacer(4)\n  }\n  addText(row, updated(data), {\n    size: 8,\n    color: data.stale ? COLORS.amber() : COLORS.quiet(),\n    monospaced: true,\n  })\n}\n\nfunction addHumidity(parent, data, width = 64) {\n  const raw = numeric(data.now.humidity)\n  const humidity = raw == null ? undefined : Math.max(0, Math.min(100, raw))\n  const row = parent.addStack()\n  row.layoutHorizontally()\n  row.centerAlignContent()\n  addSymbol(row, 'drop.fill', 8, COLORS.blue())\n  row.addSpacer(4)\n  addText(row, '湿度', { size: 9, color: COLORS.secondary() })\n  row.addSpacer(4)\n  addText(row, humidity == null ? '—' : `${Math.round(humidity)}%`, {\n    size: 9,\n    weight: 'medium',\n    color: COLORS.blue(),\n    monospaced: true,\n  })\n  row.addSpacer()\n  const barImg = drawProgressBar(width, 3.5, humidity != null ? humidity / 100 : 0, '#DCE6F1', '#257CC5')\n  const imgWidget = row.addImage(barImg)\n  imgWidget.imageSize = new Size(width, 3.5)\n}\n\nfunction addHighLow(parent, data, size = 10) {\n  const day = getToday(data)\n  const row = parent.addStack()\n  row.layoutHorizontally()\n  row.centerAlignContent()\n  addText(row, `高 ${temp(day && day.tempMax)}`, {\n    size,\n    weight: 'semibold',\n    color: COLORS.highColor(),\n    monospaced: true,\n  })\n  row.addSpacer(5)\n  addText(row, `低 ${temp(day && day.tempMin)}`, {\n    size,\n    color: COLORS.lowColor(),\n    monospaced: true,\n  })\n}\n\nfunction addDateFestival(parent, data, compact = false) {\n  const info = dateFestival(data)\n  const col = parent.addStack()\n  col.layoutVertically()\n  col.centerAlignContent()\n  col.size = new Size(compact ? 84 : 92, 0)\n  const dRow = col.addStack()\n  dRow.layoutHorizontally()\n  dRow.centerAlignContent()\n  dRow.addSpacer()\n  addText(dRow, info.date, {\n    size: compact ? 8.5 : 9.5,\n    weight: 'semibold',\n    color: COLORS.secondary(),\n    minScale: 0.7,\n  })\n  dRow.addSpacer()\n  if (info.festival) {\n    col.addSpacer(1)\n    const fRow = col.addStack()\n    fRow.layoutHorizontally()\n    fRow.centerAlignContent()\n    fRow.addSpacer()\n    addText(fRow, info.festival, {\n      size: compact ? 7.5 : 8.5,\n      weight: 'semibold',\n      color: COLORS.highColor(),\n      minScale: 0.68,\n    })\n    fRow.addSpacer()\n  }\n}\n\nfunction addHero(parent, data, opts = {}) {\n  const large = !!opts.large\n  const compact = !!opts.compact\n  const row = parent.addStack()\n  row.layoutHorizontally()\n  row.centerAlignContent()\n\n  addText(row, temp(data.now.temp), {\n    size: large ? 46 : compact ? 36 : 40,\n    weight: 'bold',\n    color: COLORS.ink(),\n    monospaced: true,\n    minScale: 0.7,\n  })\n  row.addSpacer(compact ? 4 : 8)\n  addWeatherIcon(row, data.now.icon, large ? 38 : compact ? 28 : 32, isNight(data))\n  row.addSpacer()\n  addDateFestival(row, data, compact)\n  row.addSpacer()\n\n  const right = row.addStack()\n  right.layoutVertically()\n  const condRow = right.addStack()\n  condRow.layoutHorizontally()\n  condRow.addSpacer()\n  addText(condRow, clean(data.now.text) || '实况暂缺', {\n    size: large ? 13 : 11,\n    weight: 'medium',\n    color: COLORS.ink(),\n    minScale: 0.7,\n  })\n  right.addSpacer(compact ? 2 : 4)\n  const hlRow = right.addStack()\n  hlRow.layoutHorizontally()\n  hlRow.addSpacer()\n  addHighLow(hlRow, data, large ? 11 : compact ? 9 : 10)\n}\n\nfunction addForecast(parent, data, compact = false) {\n  const days = getForecast(data)\n  const row = parent.addStack()\n  row.layoutHorizontally()\n  row.centerAlignContent()\n  if (!days.length) {\n    addText(row, '未来五天预报暂缺', { size: 10, color: COLORS.secondary() })\n    return\n  }\n  days.forEach(({ date, day }, i) => {\n    if (i > 0) row.addSpacer()\n    const col = row.addStack()\n    col.layoutVertically()\n    col.centerAlignContent()\n    col.size = new Size(compact ? 52 : 50, 0)\n    const topRow = col.addStack()\n    topRow.layoutHorizontally()\n    topRow.centerAlignContent()\n    topRow.addSpacer()\n    addText(topRow, i === 0 ? '明天' : dayLabel(date), {\n      size: compact ? 8.5 : 9,\n      weight: i === 0 ? 'semibold' : 'medium',\n      color: i === 0 ? COLORS.blue() : COLORS.secondary(),\n    })\n    topRow.addSpacer()\n    col.addSpacer(compact ? 2 : 3)\n    const mid = col.addStack()\n    mid.layoutHorizontally()\n    mid.centerAlignContent()\n    mid.addSpacer()\n    if (compact) {\n      addWeatherIcon(mid, day && day.iconDay, 13, false)\n      mid.addSpacer(2)\n      const p = clean(day && day.precip)\n      const shortWea = clean(day && day.textDay).replace(/转.*$/, '').slice(0, 3)\n      addText(mid, p ? `${p}mm` : (shortWea || '—'), {\n        size: 7.5,\n        color: p && Number(p) > 0 ? COLORS.cyan() : COLORS.quiet(),\n        monospaced: Boolean(p),\n      })\n    } else {\n      addWeatherIcon(mid, day && day.iconDay, 15, false)\n    }\n    mid.addSpacer()\n    col.addSpacer(compact ? 2 : 3)\n    const temps = col.addStack()\n    temps.layoutHorizontally()\n    temps.centerAlignContent()\n    temps.addSpacer()\n    addText(temps, temp(day && day.tempMax), {\n      size: compact ? 9 : 9.5,\n      weight: 'semibold',\n      color: COLORS.highColor(),\n      monospaced: true,\n    })\n    temps.addSpacer(3)\n    addText(temps, temp(day && day.tempMin), {\n      size: compact ? 9 : 9.5,\n      color: COLORS.lowColor(),\n      monospaced: true,\n    })\n    temps.addSpacer()\n  })\n}\n\nfunction addDetailChip(parent, symbol, value, tint, textColor) {\n  const chip = parent.addStack()\n  chip.layoutHorizontally()\n  chip.centerAlignContent()\n  addSymbol(chip, symbol, 8, tint || COLORS.blue())\n  chip.addSpacer(3)\n  addText(chip, value, {\n    size: 8.3,\n    weight: 'medium',\n    color: textColor || COLORS.secondary(),\n    minScale: 0.7,\n  })\n}\n\nfunction addHumidityDetail(parent, data) {\n  const raw = numeric(data.now.humidity)\n  const humidity = raw == null ? undefined : Math.max(0, Math.min(100, raw))\n  const row = parent.addStack()\n  row.layoutHorizontally()\n  row.centerAlignContent()\n  addSymbol(row, 'drop.fill', 8, COLORS.teal())\n  row.addSpacer(3)\n  addText(row, humidity == null ? '湿度 —' : `湿度 ${Math.round(humidity)}%`, {\n    size: 8.3,\n    weight: 'medium',\n    color: COLORS.teal(),\n    minScale: 0.75,\n  })\n  row.addSpacer(3)\n  const isTransLight = hasTransparentBg() && (settings().bgTextMode || 'light') !== 'dark'\n  const barImg = drawProgressBar(\n    18,\n    3,\n    humidity != null ? humidity / 100 : 0,\n    isTransLight ? '#FFFFFF45' : '#D7E9EA',\n    isTransLight ? '#72F2F7' : '#188E98'\n  )\n  const imgW = row.addImage(barImg)\n  imgW.imageSize = new Size(18, 3)\n}\n\nfunction addMediumDetails(parent, data) {\n  const wind = [clean(data.now.windDir), clean(data.now.windScale) ? `${clean(data.now.windScale)}级` : ''].filter(Boolean).join(' ') || '风力 —'\n  const aqi = data.aqi && clean(data.aqi.value) ? `AQI ${clean(data.aqi.label)} ${clean(data.aqi.value)}` : 'AQI —'\n  const precip = clean(data.now.precip)\n  const warning = clean(data.warnings && data.warnings[0] && data.warnings[0].title)\n  const aqiColor = data.aqi && data.aqi.label === '优' ? COLORS.green() : COLORS.amber()\n\n  const col = parent.addStack()\n  col.layoutVertically()\n\n  const row1 = col.addStack()\n  row1.layoutHorizontally()\n  row1.centerAlignContent()\n  addDetailChip(row1, 'thermometer.medium', `体感 ${temp(data.now.feelsLike)}`, COLORS.warm(), COLORS.warm())\n  row1.addSpacer()\n  addDetailChip(row1, 'wind', wind, COLORS.teal(), COLORS.teal())\n  row1.addSpacer()\n  addDetailChip(row1, 'aqi.medium', aqi, aqiColor, aqiColor)\n\n  col.addSpacer(3)\n  const row2 = col.addStack()\n  row2.layoutHorizontally()\n  row2.centerAlignContent()\n  addDetailChip(row2, 'eye', `能见度 ${unit(data.now.vis, 'km')}`, COLORS.violet(), COLORS.violet())\n  row2.addSpacer()\n  addDetailChip(row2, 'cloud.rain.fill', `降水 ${precip ? `${precip}mm` : '—'}`, COLORS.cyan(), COLORS.cyan())\n  row2.addSpacer()\n  addHumidityDetail(row2, data)\n\n  if (warning) {\n    col.addSpacer(3)\n    const wRow = col.addStack()\n    wRow.layoutHorizontally()\n    wRow.centerAlignContent()\n    addSymbol(wRow, 'exclamationmark.triangle.fill', 8, COLORS.amber())\n    wRow.addSpacer(3)\n    addText(wRow, `${warning}${data.warnings.length > 1 ? ` · 共${data.warnings.length}条` : ''}`, {\n      size: 8.2,\n      weight: 'semibold',\n      color: COLORS.amber(),\n      minScale: 0.62,\n    })\n  }\n}\n\nfunction addMetric(parent, symbol, label, value) {\n  const col = parent.addStack()\n  col.layoutVertically()\n  const top = col.addStack()\n  top.layoutHorizontally()\n  top.centerAlignContent()\n  addSymbol(top, symbol, 9, COLORS.blue())\n  top.addSpacer(4)\n  addText(top, label, { size: 9, color: COLORS.secondary() })\n  col.addSpacer(4)\n  addText(col, value, {\n    size: 11,\n    weight: 'semibold',\n    color: COLORS.ink(),\n    minScale: 0.75,\n  })\n}\n\nfunction addHours(parent, data) {\n  const hours = (data.hourly || []).slice(0, 6)\n  if (!hours.length) return false\n\n  const box = parent.addStack()\n  box.layoutHorizontally()\n  box.centerAlignContent()\n  box.backgroundColor = COLORS.panel()\n  box.cornerRadius = 12\n  box.setPadding(7, 8, 7, 8)\n\n  hours.forEach((h, idx) => {\n    if (idx > 0) box.addSpacer()\n    const col = box.addStack()\n    col.layoutVertically()\n    col.centerAlignContent()\n    col.size = new Size(42, 0)\n    const hStr = h.hourText ? String(h.hourText).slice(0, 2) : String(h.fxTime).slice(11, 13)\n    const hr = Number(hStr)\n    const r1 = col.addStack()\n    r1.layoutHorizontally()\n    r1.centerAlignContent()\n    r1.addSpacer()\n    addText(r1, `${hStr}时`, { size: 9, color: COLORS.secondary() })\n    r1.addSpacer()\n    col.addSpacer(3)\n    const r2 = col.addStack()\n    r2.layoutHorizontally()\n    r2.centerAlignContent()\n    r2.addSpacer()\n    addWeatherIcon(r2, h.icon, 15, /^n/i.test(String(h.icon || '')) || hr < 6 || hr >= 18)\n    r2.addSpacer()\n    col.addSpacer(3)\n    const r3 = col.addStack()\n    r3.layoutHorizontally()\n    r3.centerAlignContent()\n    r3.addSpacer()\n    addText(r3, temp(h.temp), {\n      size: 10,\n      weight: 'semibold',\n      color: COLORS.ink(),\n      monospaced: true,\n    })\n    r3.addSpacer()\n  })\n  return true\n}\n\nfunction buildSmall(w, data) {\n  w.setPadding(10, 13, 10, 13)\n  addHeader(w, data)\n  w.addSpacer(4)\n  const hero = w.addStack()\n  hero.layoutHorizontally()\n  hero.centerAlignContent()\n  addText(hero, temp(data.now.temp), {\n    size: 42,\n    weight: 'bold',\n    color: COLORS.ink(),\n    monospaced: true,\n    minScale: 0.65,\n  })\n  hero.addSpacer()\n  addWeatherIcon(hero, data.now.icon, 32, isNight(data))\n  w.addSpacer(2)\n  addText(w, clean(data.now.text) || '实况暂缺', {\n    size: 11,\n    weight: 'medium',\n    color: COLORS.ink(),\n  })\n  w.addSpacer(4)\n  addHighLow(w, data, 10)\n  w.addSpacer(4)\n  addHumidity(w, data, 42)\n}\n\nfunction buildMedium(w, data) {\n  const warning = clean(data.warnings && data.warnings[0] && data.warnings[0].title)\n  w.setPadding(8, 15, 8, 15)\n  addHeader(w, data)\n  w.addSpacer(2)\n  addHero(w, data, { compact: true })\n  w.addSpacer(3)\n  addMediumDetails(w, data)\n  w.addSpacer(warning ? 3 : 5)\n  addForecast(w, data, true)\n}\n\nfunction buildLarge(w, data) {\n  const warning = clean(data.warnings && data.warnings[0] && data.warnings[0].title)\n  const wind = [clean(data.now.windDir), clean(data.now.windScale) ? `${clean(data.now.windScale)}级` : '']\n    .filter(Boolean)\n    .join(' ')\n  w.setPadding(12, 16, 12, 16)\n  addHeader(w, data)\n  w.addSpacer(4)\n  addHero(w, data, { large: true })\n  w.addSpacer(4)\n  addHumidity(w, data, 100)\n  w.addSpacer(8)\n  if (addHours(w, data)) w.addSpacer(8)\n\n  const metrics = w.addStack()\n  metrics.layoutHorizontally()\n  addMetric(metrics, 'thermometer.medium', '体感', temp(data.now.feelsLike))\n  metrics.addSpacer()\n  addMetric(metrics, 'wind', '风向 / 风力', wind || unit(data.now.windSpeed, ' km/h'))\n  metrics.addSpacer()\n  addMetric(metrics, 'eye', '能见度', unit(data.now.vis, ' km'))\n\n  w.addSpacer(8)\n  addForecast(w, data, false)\n\n  if (warning) {\n    w.addSpacer(6)\n    const warnBox = w.addStack()\n    warnBox.layoutHorizontally()\n    warnBox.centerAlignContent()\n    warnBox.backgroundColor = COLORS.panel()\n    warnBox.cornerRadius = 8\n    warnBox.setPadding(5, 8, 5, 8)\n    addSymbol(warnBox, 'exclamationmark.triangle.fill', 10, COLORS.amber())\n    warnBox.addSpacer(5)\n    addText(warnBox, `${warning}${data.warnings.length > 1 ? ` · 共${data.warnings.length}条` : ''}`, {\n      size: 10,\n      weight: 'medium',\n      color: COLORS.amber(),\n    })\n  }\n}\n\nfunction createWeatherWidget(data, family) {\n  const w = new ListWidget()\n  applyWidgetBackground(w, family)\n  w.refreshAfterDate = new Date(Date.now() + 15 * 60 * 1000)\n  if (family === 'small' || family === 'systemSmall') {\n    buildSmall(w, data)\n  } else if (family === 'large' || family === 'systemLarge') {\n    buildLarge(w, data)\n  } else {\n    buildMedium(w, data)\n  }\n  return w\n}\n\nfunction createErrorWidget(errMsg, family = 'medium') {\n  const w = new ListWidget()\n  applyWidgetBackground(w, family)\n  w.setPadding(16, 16, 16, 16)\n  w.refreshAfterDate = new Date(Date.now() + 15 * 60 * 1000)\n  addText(w, '和风天气·晴雨', { size: 12, weight: 'semibold', color: COLORS.blue() })\n  w.addSpacer(6)\n  addText(w, '天气暂不可用', { size: 18, weight: 'bold', color: COLORS.ink() })\n  w.addSpacer(6)\n  addText(\n    w,\n    clean(errMsg) || '请检查网络、定位权限或位置参数，然后在 Scriptable 内点击脚本完成设置。',\n    { size: 10, color: COLORS.secondary(), lineLimit: 3 }\n  )\n  return w\n}\n\n// ─── Scriptable App 内可视化设置与预览菜单 ───\nasync function promptField(title, message, placeholder, defaultValue, secure = false) {\n  const a = new Alert()\n  a.title = title\n  a.message = message\n  if (secure) {\n    a.addSecureTextField(placeholder, defaultValue || '')\n  } else {\n    a.addTextField(placeholder, defaultValue || '')\n  }\n  a.addAction('保存')\n  a.addCancelAction('取消')\n  const idx = await a.presentAlert()\n  if (idx === -1) return null\n  return a.textFieldValue(0)\n}\n\nasync function showAlert(title, message) {\n  const a = new Alert()\n  a.title = title\n  a.message = String(message || '')\n  a.addAction('确定')\n  await a.presentAlert()\n}\n\nasync function runInAppMenu() {\n  let lastWeather = null\n  let statusMsg = '数据源：中国天气网 (免 API Key · 自动定位/支持全国城市)'\n\n  const table = new UITable()\n  table.showSeparators = true\n\n  function renderTable() {\n    table.removeAllRows()\n    const s = settings()\n\n    const titleRow = new UITableRow()\n    titleRow.isHeader = true\n    titleRow.height = 52\n    const tCell = titleRow.addText('🌤️ 和风天气·晴雨 (Scriptable)', statusMsg)\n    tCell.titleFont = Font.boldSystemFont(17)\n    tCell.subtitleFont = Font.systemFont(12)\n    tCell.subtitleColor = Color.green()\n    table.addRow(titleRow)\n\n    const addOption = (title, subtitle, onSelect) => {\n      const r = new UITableRow()\n      r.height = 50\n      r.dismissOnSelect = false\n      const c = r.addText(title, subtitle)\n      c.titleFont = Font.mediumSystemFont(15)\n      c.subtitleFont = Font.systemFont(12)\n      c.subtitleColor = Color.gray()\n      r.onSelect = onSelect\n      table.addRow(r)\n    }\n\n    addOption(\n      '📍 城市设置',\n      `当前：${s.location}（填“自动”或留空按 IP 自动定位，也可填城市名如 合肥、北京、阳江）`,\n      async () => {\n        const val = await promptField(\n          '设置城市',\n          '留空或填“自动”将通过 IP 自动定位；也可直接输入中文城市名（如 合肥、北京、阳江）或 9 位中国天气网城市代码',\n          '自动 / 合肥 / 北京 / 101220101',\n          s.location\n        )\n        if (val != null) {\n          saveSettings({ location: val.trim() || '自动' })\n          statusMsg = `城市已更新为：${settings().location}`\n          renderTable()\n        }\n      }\n    )\n\n    addOption(\n      '🔄 立即刷新实时天气',\n      lastWeather\n        ? `${lastWeather.place} ${lastWeather.now.temp}° ${lastWeather.now.text} · 观测 ${fmtTime(lastWeather.obsTime)}`\n        : '点击拉取最新实况并更新缓存',\n      async () => {\n        try {\n          const cur = settings()\n          const d = await getWeather(true, cur.location || '自动')\n          lastWeather = d\n          statusMsg = d.stale\n            ? '网络暂不可用，正在显示缓存数据'\n            : `更新完成 · ${d.place} · ${fmtTime(d.fetchedAt)}`\n          renderTable()\n        } catch (e) {\n          statusMsg = `更新失败：${e.message || e}`\n          renderTable()\n          await showAlert('更新失败', e.message || String(e))\n        }\n      }\n    )\n\n    const previewFamily = async family => {\n      try {\n        const d = await getWeather(false)\n        lastWeather = d\n        const w = createWeatherWidget(d, family)\n        if (family === 'small') await w.presentSmall()\n        else if (family === 'large') await w.presentLarge()\n        else await w.presentMedium()\n      } catch (e) {\n        const w = createErrorWidget(e.message)\n        if (family === 'small') await w.presentSmall()\n        else if (family === 'large') await w.presentLarge()\n        else await w.presentMedium()\n      }\n    }\n\n    const textModeLabel =\n      (s.bgTextMode || 'light') === 'dark'\n        ? '深色浓黑字'\n        : (s.bgTextMode || 'light') === 'auto'\n        ? '跟随系统'\n        : '高亮白字+立体阴影'\n\n    addOption(\n      '🎨 透明 / 自定义背景设置',\n      hasTransparentBg()\n        ? `当前：已启用透明背景 · 字体：${textModeLabel}（点击可切换字体颜色或重裁壁纸）`\n        : '当前：默认蓝灰渐变（点击可从空白桌面截图一键裁切透明背景）',\n      async () => {\n        const menu = new Alert()\n        menu.title = '透明 / 自定义背景设置'\n        menu.message =\n          '提示：如果透明背景后文字看不清，可点击「切换透明背景字体颜色」或重新裁切时加上深色/浅色蒙版。'\n        menu.addAction('🔤 切换透明背景字体颜色（立即生效）')\n        menu.addAction('✂️ 从空白桌面截图自动裁切（透明背景）')\n        menu.addAction('🏞️ 从相册直接选择背景图')\n        menu.addDestructiveAction('🗑️ 清除透明背景（恢复默认渐变）')\n        menu.addCancelAction('取消')\n        const actionIdx = await menu.presentSheet()\n        if (actionIdx === -1) return\n\n        const fm = FileManager.local()\n\n        if (actionIdx === 0) {\n          const tmAlert = new Alert()\n          tmAlert.title = '选择透明背景字体颜色'\n          tmAlert.message = '针对不同明暗度的手机壁纸，选择最清晰的文字与图标配色：'\n          tmAlert.addAction('🌟 纯白高亮字 + 立体阴影（推荐 · 适配深色/灰蓝/风景壁纸）')\n          tmAlert.addAction('🖤 深邃浓黑字 + 柔白光晕（适配纯白/极浅色壁纸）')\n          tmAlert.addAction('🔄 跟随系统白天/夜晚模式')\n          tmAlert.addCancelAction('取消')\n          const tmIdx = await tmAlert.presentSheet()\n          if (tmIdx === -1) return\n          const nextMode = tmIdx === 1 ? 'dark' : tmIdx === 2 ? 'auto' : 'light'\n          saveSettings({ bgTextMode: nextMode })\n          statusMsg = `透明背景字体已切换为：${\n            nextMode === 'dark' ? '深邃浓黑字' : nextMode === 'auto' ? '跟随系统' : '纯白高亮字+阴影'\n          }`\n          renderTable()\n          return\n        }\n\n        if (actionIdx === 3) {\n          ;['small', 'medium', 'large'].forEach(f => {\n            const p = getBgFilePath(f)\n            if (fm.fileExists(p)) fm.remove(p)\n          })\n          if (fm.fileExists(getCustomBgFilePath())) fm.remove(getCustomBgFilePath())\n          statusMsg = '已恢复默认蓝灰渐变背景'\n          renderTable()\n          return\n        }\n\n        const maskAlert = new Alert()\n        maskAlert.title = '选择背景蒙版效果'\n        maskAlert.message = '如果壁纸颜色较杂，叠加一层半透明暗色或浅色蒙版能让天气文字更清晰'\n        maskAlert.addAction('✨ 纯净全透明（不加蒙版）')\n        maskAlert.addAction('🌙 深色磨砂蒙版（推荐 · 压暗壁纸让白字更突出）')\n        maskAlert.addAction('🌤️ 浅色柔光蒙版（适合配深色文字）')\n        maskAlert.addCancelAction('取消')\n        const maskIdx = await maskAlert.presentSheet()\n        if (maskIdx === -1) return\n        const overlayMode = maskIdx === 1 ? 'dark' : maskIdx === 2 ? 'light' : 'none'\n        if (overlayMode === 'light') {\n          saveSettings({ bgTextMode: 'dark' })\n        } else {\n          saveSettings({ bgTextMode: 'light' })\n        }\n\n        if (actionIdx === 2) {\n          try {\n            const rawImg = await Photos.fromLibrary()\n            if (!rawImg) return\n            const processed = applyOverlayToImage(rawImg, rawImg.size.width, rawImg.size.height, overlayMode)\n            fm.writeImage(getCustomBgFilePath(), processed)\n            ;['small', 'medium', 'large'].forEach(f => {\n              const p = getBgFilePath(f)\n              if (fm.fileExists(p)) fm.remove(p)\n            })\n            statusMsg = '自定义背景图已保存！'\n            renderTable()\n          } catch (_) {}\n          return\n        }\n\n        // 自动裁切模式\n        const sizeAlert = new Alert()\n        sizeAlert.title = '选择桌面小组件尺寸'\n        sizeAlert.addAction('中号组件 (Medium · 推荐)')\n        sizeAlert.addAction('小号组件 (Small)')\n        sizeAlert.addAction('大号组件 (Large)')\n        sizeAlert.addCancelAction('取消')\n        const sizeIdx = await sizeAlert.presentSheet()\n        if (sizeIdx === -1) return\n        const targetFamily = sizeIdx === 1 ? 'small' : sizeIdx === 2 ? 'large' : 'medium'\n\n        const posAlert = new Alert()\n        posAlert.title = '选择小组件在桌面的位置'\n        let posKeys = []\n        if (targetFamily === 'small') {\n          posKeys = [\n            ['左上 (Top Left)', 'top-left'],\n            ['右上 (Top Right)', 'top-right'],\n            ['左中 (Middle Left)', 'middle-left'],\n            ['右中 (Middle Right)', 'middle-right'],\n            ['左下 (Bottom Left)', 'bottom-left'],\n            ['右下 (Bottom Right)', 'bottom-right'],\n          ]\n        } else if (targetFamily === 'medium') {\n          posKeys = [\n            ['顶部 (第 1~2 行 · Top)', 'top'],\n            ['中部 (第 3~4 行 · Middle)', 'middle'],\n            ['底部 (第 5~6 行 · Bottom)', 'bottom'],\n          ]\n        } else {\n          posKeys = [\n            ['上半屏 (第 1~4 行 · Top)', 'top'],\n            ['下半屏 (第 3~6 行 · Bottom)', 'bottom'],\n          ]\n        }\n        posKeys.forEach(([label]) => posAlert.addAction(label))\n        posAlert.addCancelAction('取消')\n        const posIdx = await posAlert.presentSheet()\n        if (posIdx === -1) return\n        const selectedPos = posKeys[posIdx][1]\n\n        try {\n          const wallImg = await Photos.fromLibrary()\n          if (!wallImg) return\n          const cropped = cropWallpaperForWidget(wallImg, targetFamily, selectedPos, overlayMode)\n          fm.writeImage(getBgFilePath(targetFamily), cropped)\n          statusMsg = `透明背景已生成（${targetFamily} · ${posKeys[posIdx][0]}）`\n          renderTable()\n        } catch (e) {\n          await showAlert('裁切失败', e && e.message ? e.message : String(e))\n        }\n      }\n    )\n\n    addOption('🖼️ 预览中号 · 五日天气卡 (推荐)', '点击预览 Medium 尺寸桌面组件', () => previewFamily('medium'))\n    addOption('🖼️ 预览小号 · 简洁实况卡', '点击预览 Small 尺寸桌面组件', () => previewFamily('small'))\n    addOption('🖼️ 预览大号 · 逐时与预警卡', '点击预览 Large 尺寸桌面组件', () => previewFamily('large'))\n\n    table.reload()\n  }\n\n  renderTable()\n  await table.present(false)\n}\n\n// ─── 主入口 ───\nasync function main() {\n  if (config.runsInWidget) {\n    try {\n      const data = await getWeather(false)\n      const widget = createWeatherWidget(data, config.widgetFamily || 'medium')\n      Script.setWidget(widget)\n    } catch (e) {\n      Script.setWidget(createErrorWidget(e && e.message))\n    }\n    Script.complete()\n  } else {\n    await runInAppMenu()\n    Script.complete()\n  }\n}\n\nmain()\n\n",
  "share_sheet_inputs": []
}